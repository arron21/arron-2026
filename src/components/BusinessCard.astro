---
// Standalone BusinessCard component with zero runtime or build-time dependencies
---

<div class="business-card-wrapper">
	<!-- 3D Flip Card Scene -->
	<div class="flip-card-scene" id="flip-card-scene">
		<div class="flip-card-inner" id="flip-card-inner">
			
			<!-- Front Side -->
			<div class="flip-card-face flip-card-front tui-window blue-168">
				<div class="card-border-box">
					<div class="card-top-row">
						<span class="card-badge yellow-255-text">[ DIGITAL CARD ]</span>
						<span class="card-status green-255-text">● ONLINE</span>
					</div>

					<div class="card-identity">
						<h3 class="card-name white-255-text">ARRON McCRORY</h3>
						<p class="card-title cyan-255-text">Senior Frontend Engineer</p>
						<p class="card-subtitle white-168-text">Frontend Architect</p>
					</div>

					<div class="card-specialties white-255-text">
						<span>Angular</span> • <span>TypeScript</span> • <span>Design Systems</span>
					</div>

					<div class="card-contact-info">
						<div class="card-info-row">
							<span class="cyan-255-text">WEB:</span>
							<span class="white-255-text">arronmccrory.com</span>
						</div>
						<div class="card-info-row">
							<span class="cyan-255-text">GIT:</span>
							<span class="white-255-text">github.com/arron21</span>
						</div>
						<div class="card-info-row">
							<span class="cyan-255-text">IN:</span>
							<span class="white-255-text">linkedin.com/in/arronmccrory</span>
						</div>
					</div>

					<div class="card-flip-hint yellow-255-text">
						<span class="hint-arrow">&larr;</span> SWIPE OR TAP FOR QR CODE <span class="hint-arrow">&rarr;</span>
					</div>
				</div>
			</div>

			<!-- Back Side -->
			<div class="flip-card-face flip-card-back tui-window black-168">
				<div class="card-border-box">
					<div class="card-top-row">
						<span class="card-badge cyan-255-text">[ SCAN TO CONNECT ]</span>
						<span class="card-status yellow-255-text">HOMEPAGE</span>
					</div>

					<div class="card-qr-container">
						<a
							href="https://arronmccrory.com/"
							class="card-qr-link"
							aria-label="Visit Homepage"
							target="_blank"
							rel="noopener noreferrer"
						>
							<div class="card-qr-frame">
								<!-- Crisp Vector QR Code linking to https://arronmccrory.com/ -->
								<svg xmlns="http://www.w3.org/2000/svg" width="115" height="115" viewBox="0 0 27 27" shape-rendering="crispEdges">
									<path fill="#ffffff" d="M0 0h27v27H0z"/>
									<path stroke="#000000" d="M1 1.5h7m2 0h2m2 0h1m2 0h1m1 0h7M1 2.5h1m5 0h1m2 0h1m1 0h5m2 0h1m5 0h1M1 3.5h1m1 0h3m1 0h1m1 0h2m1 0h1m2 0h1m3 0h1m1 0h3m1 0h1M1 4.5h1m1 0h3m1 0h1m1 0h4m1 0h4m1 0h1m1 0h3m1 0h1M1 5.5h1m1 0h3m1 0h1m1 0h2m2 0h1m1 0h1m1 0h1m1 0h1m1 0h3m1 0h1M1 6.5h1m5 0h1m1 0h2m1 0h1m1 0h1m1 0h2m1 0h1m5 0h1M1 7.5h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7M9 8.5h1m1 0h1M1 9.5h1m1 0h5m2 0h1m3 0h3m2 0h5M1 10.5h2m2 0h1m3 0h1m1 0h5m1 0h2m1 0h1m3 0h1M3 11.5h2m1 0h2m3 0h2m3 0h2m1 0h2m1 0h1m1 0h2M4 12.5h1m1 0h1m6 0h1m1 0h1m9 0h1M1 13.5h2m1 0h1m2 0h1m2 0h3m1 0h1m1 0h1m1 0h2m1 0h1m1 0h3M1 14.5h1m1 0h2m1 0h1m3 0h1m2 0h2m2 0h2m1 0h1m1 0h1m1 0h1M1 15.5h1m3 0h3m1 0h2m3 0h4m1 0h4m1 0h2M1 16.5h1m2 0h1m1 0h1m2 0h3m1 0h1m2 0h2m2 0h2m3 0h1M1 17.5h1m1 0h1m1 0h7m1 0h3m1 0h5m1 0h1M9 18.5h1m6 0h2m3 0h2M1 19.5h7m3 0h4m2 0h1m1 0h1m1 0h1m1 0h3M1 20.5h1m5 0h1m1 0h2m1 0h1m2 0h1m1 0h1m3 0h2m2 0h1M1 21.5h1m1 0h3m1 0h1m1 0h1m2 0h10m1 0h1M1 22.5h1m1 0h3m1 0h1m1 0h1m3 0h2m1 0h4m1 0h5M1 23.5h1m1 0h3m1 0h1m1 0h2m3 0h2m1 0h1m4 0h2m1 0h1M1 24.5h1m5 0h1m2 0h1m4 0h4m1 0h3m2 0h1M1 25.5h7m1 0h7m2 0h1m1 0h6"/>
								</svg>
							</div>
						</a>
						<p class="card-qr-label white-255-text">Scan with phone camera</p>
						<p class="card-qr-url cyan-255-text">arronmccrory.com</p>
					</div>

					<div class="card-flip-hint yellow-255-text">
						<span class="hint-arrow">&larr;</span> SWIPE OR TAP FOR DETAILS <span class="hint-arrow">&rarr;</span>
					</div>
				</div>
			</div>

		</div>
	</div>

	<!-- Action Controls -->
	<div class="card-actions-bar">
		<button type="button" id="flip-action-btn" class="tui-button yellow-255 black-text">
			[ ⟳ Flip Card / QR Code ]
		</button>
	</div>

	<p class="card-gesture-hint white-168-text">
		💡 Swipe or click card to flip between info & QR code
	</p>
</div>

<style>
	.business-card-wrapper {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		margin: 0.5rem 0;
	}

	/* 3D Flip Card Scene & Inner */
	.flip-card-scene {
		width: 100%;
		max-width: 360px;
		height: 230px;
		perspective: 1200px;
		cursor: grab;
		user-select: none;
		-webkit-user-select: none;
		touch-action: none;
	}

	.flip-card-scene:active {
		cursor: grabbing;
	}

	.flip-card-inner {
		position: relative;
		width: 100%;
		height: 100%;
		text-align: left;
		transition: transform 0.6s cubic-bezier(0.2, 0.85, 0.35, 1.2);
		transform-style: preserve-3d;
		-webkit-transform-style: preserve-3d;
	}

	.flip-card-inner.is-flipped {
		transform: rotateY(180deg);
		-webkit-transform: rotateY(180deg);
	}

	/* Faces */
	.flip-card-face {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		-webkit-backface-visibility: hidden;
		backface-visibility: hidden;
		border: 2px solid #a8a8a8;
		box-shadow: 4px 4px 0px #000;
		overflow: hidden;
		padding: 6px;
		box-sizing: border-box;
	}

	.flip-card-front {
		transform: rotateY(0deg);
		-webkit-transform: rotateY(0deg);
	}

	.flip-card-back {
		transform: rotateY(180deg);
		-webkit-transform: rotateY(180deg);
	}

	.card-border-box {
		width: 100%;
		height: 100%;
		border: 1px dashed rgba(255, 255, 255, 0.4);
		padding: 10px 12px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		box-sizing: border-box;
	}

	/* Front Card Elements */
	.card-top-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.75rem;
	}

	.card-badge {
		font-weight: bold;
		letter-spacing: 0.5px;
	}

	.card-status {
		font-size: 0.7rem;
	}

	.card-identity {
		margin: 2px 0;
	}

	.card-name {
		font-size: 1.2rem;
		margin: 0;
		letter-spacing: 1px;
		font-weight: bold;
		line-height: 1.2;
	}

	.card-title {
		font-size: 0.85rem;
		margin: 2px 0 0;
		font-weight: bold;
	}

	.card-subtitle {
		font-size: 0.75rem;
		margin: 1px 0 0;
	}

	.card-specialties {
		font-size: 0.75rem;
		line-height: 1.3;
		opacity: 0.9;
	}

	.card-contact-info {
		font-size: 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 2px;
		background: rgba(0, 0, 0, 0.25);
		padding: 3px 6px;
		border-left: 2px solid #00a8a8;
	}

	.card-info-row {
		display: flex;
		gap: 6px;
	}

	.card-flip-hint {
		text-align: center;
		font-size: 0.72rem;
		font-weight: bold;
		letter-spacing: 0.5px;
		animation: pulse-hint 2s infinite ease-in-out;
	}

	@keyframes pulse-hint {
		0%, 100% { opacity: 0.8; }
		50% { opacity: 1; }
	}

	.hint-arrow {
		display: inline-block;
	}

	/* Back Card Elements */
	.card-qr-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		margin: auto 0;
	}

	.card-qr-link {
		display: inline-block;
		text-decoration: none;
	}

	.card-qr-frame {
		background: #ffffff;
		padding: 4px;
		border: 2px solid #a8a8a8;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 2px 2px 0px #000;
	}

	.card-qr-frame svg {
		width: 100px;
		height: 100px;
		display: block;
	}

	.card-qr-label {
		font-size: 0.75rem;
		margin: 0;
	}

	.card-qr-url {
		font-size: 0.85rem;
		font-weight: bold;
		margin: 0;
		letter-spacing: 0.5px;
	}

	/* Action Buttons */
	.card-actions-bar {
		display: flex;
		width: 100%;
		max-width: 360px;
		justify-content: center;
	}

	.card-actions-bar button {
		width: 100%;
		padding: 0.6rem 1rem;
		font-size: 0.95rem;
		font-weight: bold;
		cursor: pointer;
		box-shadow: 2px 2px 0px #000;
	}

	.card-actions-bar button:hover {
		filter: brightness(1.1);
	}

	.card-gesture-hint {
		font-size: 0.75rem;
		margin: 0;
		text-align: center;
	}
</style>

<script is:inline>
	(function () {
		const flipActionBtn = document.getElementById('flip-action-btn');
		const cardScene = document.getElementById('flip-card-scene');
		const cardInner = document.getElementById('flip-card-inner');

		if (!cardInner || !cardScene) return;

		let isFlipped = false;
		let isTracking = false;
		let startX = 0;
		let startY = 0;
		let deltaX = 0;
		let deltaY = 0;
		let startTime = 0;

		function applyFlipState(flipped, animated) {
			isFlipped = flipped;
			cardInner.style.transition = animated ? 'transform 0.6s cubic-bezier(0.2, 0.85, 0.35, 1.2)' : 'none';
			if (isFlipped) {
				cardInner.classList.add('is-flipped');
				cardInner.style.transform = 'rotateY(180deg)';
			} else {
				cardInner.classList.remove('is-flipped');
				cardInner.style.transform = 'rotateY(0deg)';
			}

			if (animated) {
				setTimeout(function () {
					if (!isTracking) {
						cardInner.style.transform = '';
						cardInner.style.transition = '';
					}
				}, 600);
			}
		}

		function toggleFlip() {
			applyFlipState(!isFlipped, true);
		}

		if (flipActionBtn) flipActionBtn.addEventListener('click', toggleFlip);

		// Pointer & Touch Events
		function onPointerStart(clientX, clientY) {
			isTracking = true;
			startX = clientX;
			startY = clientY;
			deltaX = 0;
			deltaY = 0;
			startTime = Date.now();
			cardInner.style.transition = 'none';
		}

		function onPointerMove(clientX, clientY, e) {
			if (!isTracking) return;
			deltaX = clientX - startX;
			deltaY = clientY - startY;

			if (e && e.cancelable) {
				e.preventDefault();
			}

			// Interactive drag tilt during swipe
			const baseRotation = isFlipped ? 180 : 0;
			const dragRotation = Math.max(-180, Math.min(180, (deltaX / 220) * 180));
			cardInner.style.transform = 'rotateY(' + (baseRotation + dragRotation) + 'deg)';
		}

		function onPointerEnd() {
			if (!isTracking) return;
			isTracking = false;
			const duration = Date.now() - startTime;
			const distanceX = Math.abs(deltaX);
			const isSwipe = distanceX > 30 || (distanceX > 15 && duration < 250);
			const isTap = distanceX < 8 && Math.abs(deltaY) < 8 && duration < 300;

			if (isSwipe || isTap) {
				toggleFlip();
			} else {
				// Snap back to current state
				applyFlipState(isFlipped, true);
			}
		}

		// Touch events
		cardScene.addEventListener('touchstart', function (e) {
			if (e.touches.length === 1) {
				onPointerStart(e.touches[0].clientX, e.touches[0].clientY);
			}
		}, { passive: true });

		cardScene.addEventListener('touchmove', function (e) {
			if (e.touches.length === 1) {
				onPointerMove(e.touches[0].clientX, e.touches[0].clientY, e);
			}
		}, { passive: false });

		cardScene.addEventListener('touchend', function () {
			onPointerEnd();
		});

		cardScene.addEventListener('touchcancel', function () {
			onPointerEnd();
		});

		// Mouse events (for desktop dev tools / browser testing)
		cardScene.addEventListener('mousedown', function (e) {
			if (e.target.closest('a')) return;
			onPointerStart(e.clientX, e.clientY);
		});

		window.addEventListener('mousemove', function (e) {
			if (isTracking) {
				onPointerMove(e.clientX, e.clientY, e);
			}
		});

		window.addEventListener('mouseup', function () {
			if (isTracking) {
				onPointerEnd();
			}
		});
	})();
</script>
