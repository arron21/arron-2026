---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="tui-window blue-168 tui-page-window">
		<fieldset class="tui-fieldset white-255-border">
			<legend class="white-255-text">Welcome</legend>
			<h1 class="white-255-text">Hello, I'm Arron</h1>
			<h2 class="cyan-255-text">Senior Frontend Engineer</h2>
			<p class="white-255-text">
				Senior Frontend Engineer / Frontend Architect with 10+ years of experience building and
				modernizing enterprise web applications, design systems, and cloud platforms. Specializes in
				Angular, TypeScript, frontend architecture, and schema-driven UI, with a track record of
				replacing legacy systems, building greenfield platforms, scaling engineering teams, and
				delivering complex security and configuration experiences across enterprise environments.
			</p>
		</fieldset>
	</div>

	<div class="tui-window black-168 tui-page-window">
		<fieldset class="tui-fieldset white-168-border">
			<legend class="white-168-text">Navigate</legend>
			<ul class="nav-list">
				<li><a href="/web-development" class="tui-button cyan-168 black-text">[ Web Development ]</a></li>
				<li><a href="/photography" class="tui-button cyan-168 black-text">[ Photography ]</a></li>
				<li><a href="/about" class="tui-button cyan-168 black-text">[ About ]</a></li>
				<li><a href="/contact" class="tui-button cyan-168 black-text">[ Contact ]</a></li>
			</ul>
		</fieldset>
	</div>
</Layout>

<style>
	.nav-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.nav-list a {
		text-decoration: none;
		display: inline-block;
	}
</style>
